# Optional: scripts/setup.py generates private, persistent values in .env.
# Without APP_SECRET_KEY, Docker persists a random key inside /data/instance.
APP_SECRET_KEY=
INVENTORY_PORT=5000
INVENTORY_BIND_ADDRESS=127.0.0.1
INVENTORY_INITIAL_ADMIN_USERNAME=
INVENTORY_INITIAL_ADMIN_PASSWORD=
BACKUP_ENCRYPTION_KEY=
INVENTORY_LINKS_ENCRYPTION_KEY=
INVENTORY_UPDATER_ENABLED=0
